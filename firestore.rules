rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function mine(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isOwner() {
      return signedIn() &&
        resource.data.get('ownerUid', null) == request.auth.uid;
    }

    function isSupporter() {
      return signedIn() &&
        resource.data.get('supporterUid', null) == request.auth.uid;
    }

    // =========================
    // USERS
    // =========================
    match /users/{uid} {
      // Signed in users can read user profile documents (e.g. name for connections)
      allow get: if signedIn();
      allow list: if mine(uid);
      allow create, update: if mine(uid);
      allow delete: if false;

      // Private cycle records — only accessible to the account owner
      match /cycles/{cycleId} {
        allow read, write: if mine(uid);
      }

      // Private daily health logs — only accessible to the account owner
      match /healthEntries/{entryId} {
        allow read, write: if mine(uid);
      }
    }

    // =========================
    // INVITATION CODES
    // =========================
    match /inviteCodes/{code} {
      // Any signed-in user can resolve an invitation code by direct document get
      allow get: if signedIn();
      allow list: if false;

      // Owner creates the invite code in the same batch as the connection document
      allow create: if signedIn() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.connectionId is string;

      allow update, delete: if false;
    }

    // =========================
    // CONNECTIONS
    // =========================
    match /connections/{connectionId} {

      allow create: if signedIn() &&
        request.resource.data.get('ownerUid', null) == request.auth.uid;

      // Owner, existing supporter, or a signed-in user resolving a pending unattached invitation
      allow get: if signedIn() && (
        resource.data.get('ownerUid', null) == request.auth.uid ||
        resource.data.get('supporterUid', null) == request.auth.uid ||
        (
          resource.data.get('status', '') == 'pending' &&
          resource.data.get('supporterUid', null) == null
        )
      );

      allow list: if signedIn() &&
        (
          resource.data.get('ownerUid', null) == request.auth.uid ||
          resource.data.get('supporterUid', null) == request.auth.uid
        );

      allow update: if signedIn() && (
        // Owner can update any field (approve, modify sharing, revoke)
        resource.data.get('ownerUid', null) == request.auth.uid ||
        // Supporter attaches own UID to a pending unattached connection
        (
          resource.data.get('status', '') == 'pending' &&
          resource.data.get('supporterUid', null) == null &&
          request.resource.data.get('ownerUid', null) == resource.data.get('ownerUid', null) &&
          request.resource.data.get('status', '') == 'pending' &&
          request.resource.data.get('supporterUid', null) == request.auth.uid
        ) ||
        // Active supporter can leave / revoke their own connection
        (
          resource.data.get('status', '') == 'active' &&
          resource.data.get('supporterUid', null) == request.auth.uid &&
          request.resource.data.get('status', '') == 'revoked'
        )
      );

      allow delete: if false;

      // =========================
      // SANITIZED SHARED PROJECTION
      // =========================
      match /shared/{documentId} {

        function parentConnection() {
          return get(
            /databases/$(database)/documents/connections/$(connectionId)
          );
        }

        allow get, list: if signedIn() &&
          parentConnection().data.status == 'active' &&
          (
            parentConnection().data.ownerUid == request.auth.uid ||
            parentConnection().data.supporterUid == request.auth.uid
          );

        allow create, update: if signedIn() &&
          parentConnection().data.ownerUid == request.auth.uid;

        allow delete: if false;
      }
    }
  }
}